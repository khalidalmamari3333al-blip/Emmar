# انسخ هذا الملف إلى .env واملأ القيم من لوحة Supabase (Project Settings → API).
# مسموح فقط بالمفتاح العام: "anon public" أو "Publishable key" (sb_publishable_...). لا تضع service_role أو أي مفتاح سري هنا أبدًا.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# true = عرض بيانات تجريبية واضحة الوسم (للتطوير فقط)
EXPO_PUBLIC_USE_MOCK_DATA=true
